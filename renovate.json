{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "enabled": true,
    "timezone": "Asia/Tokyo",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticCommits",
        ":semanticCommitTypeAll(chore)"
    ],
    // Every Saturday at AM 0:00
    "schedule": [
        "0 0 * * 6"
    ],
    // Base branch for PRs
    "baseBranches": [
        "develop"
    ],
    // Dart support
    "dart": {
        "enabled": true
    },
    "packageRules": [
        // Patch is auto-merged
        {
            "matchManagers": [
                "dart"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": false,
            "labels": [
                "dependencies",
                "auto-merge"
            ]
        },
        // major, minor updates are not auto-merged
        {
            "matchManagers": [
                "dart"
            ],
            "matchUpdateTypes": [
                "major",
                "minor"
            ],
            "automerge": false,
            "labels": [
                "dependencies"
            ]
        }
    ]
}
